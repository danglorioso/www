---
/**
 * Full-page noisy gradient background (navy palette).
 *
 * Same technique as noiseandgradient.com: soft colour blobs composited over a
 * base, sampled at a per-pixel random jitter ("chaos" -> dithered blob edges),
 * plus monochrome luminance grain. Drawn with WebGL at device resolution into
 * a viewport-sized fixed canvas; the CSS gradient on the wrapper is the
 * fallback shown before paint or when WebGL is unavailable.
 *
 * Composition lives in page space: x spans a virtual width of 1.6, y is
 * measured in viewport heights from the top of the document. The canvas is
 * redrawn on scroll with the page offset, so the gradient scrolls with the
 * content. It runs one way only: a soft navy glow at the top-right of the
 * page fading into one even navy base for the rest of the page. Grain and
 * chaos noise are hashed in page space too, so the texture scrolls with the
 * content like a printed surface.
 */
---

<div class="noise-bg" aria-hidden="true">
  <canvas class="noise-bg__canvas"></canvas>
</div>

<script>
  const CHAOS = 0.1;
  const GRAIN = 0.1;

  const VERT = `
    attribute vec2 aPos;
    void main() { gl_Position = vec4(aPos, 0.0, 1.0); }
  `;

  const FRAG = `
    #ifdef GL_FRAGMENT_PRECISION_HIGH
    precision highp float;
    #else
    precision mediump float;
    #endif

    uniform vec2 uRes;     // canvas size in device px
    uniform float uCell;   // grain cell size in device px (1 CSS px)
    uniform float uChaos;
    uniform float uGrain;
    uniform float uScroll;      // scroll offset in viewport heights (gradient)
    uniform float uScrollCells; // scroll offset in grain cells, mod 4096 (texture)

    // Dave Hoskins' sine-free hash
    float hash12(vec2 p) {
      vec3 p3 = fract(vec3(p.xyx) * 0.1031);
      p3 += dot(p3, p3.yzx + 33.33);
      return fract((p3.x + p3.y) * p3.z);
    }

    vec3 blob(vec3 col, vec2 p, vec3 c, vec2 at, vec2 r, float a) {
      float d = clamp(length((p - at) / r), 0.0, 1.0);
      return mix(col, c, a * (1.0 - smoothstep(0.0, 1.0, d)));
    }

    vec3 field(vec2 p) {
      // gentle domain warp so blob edges are organic, not elliptical
      p += 0.1 * sin(vec2(2.6 * p.y + 1.2, 2.6 * p.x + 2.04));

      vec3 col = vec3(0.043, 0.078, 0.149); // #0b1426 everywhere below the glow

      // light only at the top of the page, fading into the base
      col = blob(col, p, vec3(0.090, 0.145, 0.329), vec2(0.95, 0.30), vec2(0.90, 0.60), 0.30); // #172554
      col = blob(col, p, vec3(0.118, 0.196, 0.400), vec2(1.30, 0.10), vec2(0.95, 0.75), 0.45); // #1e3266
      return col;
    }

    void main() {
      vec2 uv = gl_FragCoord.xy / uRes;
      vec2 p = vec2(uv.x * 1.6, 1.0 - uv.y + uScroll);

      // noise cells in page space (rows counted top-down + scroll) so the
      // texture scrolls with the content; wrapped to keep hash inputs small
      float row = floor((uRes.y - gl_FragCoord.y) / uCell);
      vec2 cell = vec2(floor(gl_FragCoord.x / uCell), mod(row + uScrollCells, 4096.0));
      vec2 jitter = vec2(hash12(cell), hash12(cell + 17.31)) - 0.5;
      vec3 col = field(p + jitter * (uChaos / 2.0));

      col += (hash12(cell + 91.7) - 0.5) * (uGrain / 2.5);
      gl_FragColor = vec4(col, 1.0);
    }
  `;

  function initNoiseBackground() {
    const canvas = document.querySelector<HTMLCanvasElement>(".noise-bg__canvas");
    if (!canvas) return;

    const gl = canvas.getContext("webgl", {
      alpha: false,
      antialias: false,
      depth: false,
      stencil: false,
      powerPreference: "low-power",
    });
    if (!gl) return; // CSS gradient fallback stays visible

    function compile(type: number, src: string) {
      const s = gl!.createShader(type)!;
      gl!.shaderSource(s, src);
      gl!.compileShader(s);
      return s;
    }

    const prog = gl.createProgram()!;
    gl.attachShader(prog, compile(gl.VERTEX_SHADER, VERT));
    gl.attachShader(prog, compile(gl.FRAGMENT_SHADER, FRAG));
    gl.linkProgram(prog);
    if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) return;
    gl.useProgram(prog);

    // one oversized triangle covering the viewport
    gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
    const aPos = gl.getAttribLocation(prog, "aPos");
    gl.enableVertexAttribArray(aPos);
    gl.vertexAttribPointer(aPos, 2, gl.FLOAT, false, 0, 0);

    const uRes = gl.getUniformLocation(prog, "uRes");
    const uCell = gl.getUniformLocation(prog, "uCell");
    const uScroll = gl.getUniformLocation(prog, "uScroll");
    const uScrollCells = gl.getUniformLocation(prog, "uScrollCells");
    gl.uniform1f(gl.getUniformLocation(prog, "uChaos"), CHAOS);
    gl.uniform1f(gl.getUniformLocation(prog, "uGrain"), GRAIN);

    function draw() {
      const dpr = window.devicePixelRatio || 1;
      const cssH = canvas!.clientHeight;
      const w = Math.round(canvas!.clientWidth * dpr);
      const h = Math.round(cssH * dpr);
      if (!w || !h) return;
      const cellPx = Math.max(1, Math.round(dpr));

      if (canvas!.width !== w || canvas!.height !== h) {
        canvas!.width = w;
        canvas!.height = h;
        gl!.viewport(0, 0, w, h);
        gl!.uniform2f(uRes, w, h);
        gl!.uniform1f(uCell, cellPx);
      }

      // whole cells only, so fractional (trackpad) scroll doesn't shimmer the grain;
      // positive modulo also handles negative overscroll bounce
      const cells = Math.round((window.scrollY * dpr) / cellPx);
      gl!.uniform1f(uScrollCells, ((cells % 4096) + 4096) % 4096);
      gl!.uniform1f(uScroll, window.scrollY / cssH);
      gl!.drawArrays(gl!.TRIANGLES, 0, 3);
      canvas!.dataset.ready = "true";
    }

    let pending = false;
    function schedule() {
      if (pending) return;
      pending = true;
      requestAnimationFrame(() => {
        pending = false;
        draw();
      });
    }

    window.addEventListener("scroll", schedule, { passive: true });
    window.addEventListener("resize", schedule);

    draw();
  }

  initNoiseBackground();
</script>

<style>
  .noise-bg {
    position: fixed;
    top: 0;
    left: 0;
    z-index: -20;
    width: 100%;
    /* large viewport height: mobile URL bar show/hide doesn't trigger re-renders */
    height: 100vh;
    height: 100lvh;
    pointer-events: none;
    /* fallback ≈ first screen of the shader (CSS lists top layer first) */
    background:
      radial-gradient(59.4% 75% at 81.25% 10%, rgba(30, 50, 102, 0.45), rgba(30, 50, 102, 0.22) 50%, transparent),
      radial-gradient(56% 60% at 59% 30%, rgba(23, 37, 84, 0.3), rgba(23, 37, 84, 0.15) 50%, transparent),
      #0b1426;
  }

  .noise-bg__canvas {
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.6s ease-out;
  }

  .noise-bg__canvas[data-ready] {
    opacity: 1;
  }
</style>
