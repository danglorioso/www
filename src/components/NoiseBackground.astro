---
/**
 * Full-page noisy gradient background (navy palette).
 *
 * Same technique as noiseandgradient.com: soft colour blobs composited over a
 * base, sampled at a per-pixel random jitter ("chaos" -> dithered blob edges),
 * plus monochrome luminance grain. Drawn with WebGL at device resolution into
 * a viewport-sized fixed canvas; the CSS gradient on the wrapper is the
 * fallback shown before paint or when WebGL is unavailable.
 *
 * Composition lives in a virtual space 1.6 wide where y is measured in
 * viewport heights down the page, so phones get the same layout stretched.
 * The blob pattern repeats every PERIOD viewport heights and the canvas is
 * redrawn on scroll with the page offset, so the gradient scrolls with the
 * content and keeps going on long pages. Grain stays screen-anchored (film
 * grain) so it doesn't shimmer while scrolling.
 */
---

<div class="noise-bg" aria-hidden="true">
  <canvas class="noise-bg__canvas"></canvas>
</div>

<script>
  const CHAOS = 0.1;
  const GRAIN = 0.1;
  const PERIOD = 1.6; // viewport heights per repeat of the blob pattern

  const VERT = `
    attribute vec2 aPos;
    void main() { gl_Position = vec4(aPos, 0.0, 1.0); }
  `;

  const FRAG = `
    #ifdef GL_FRAGMENT_PRECISION_HIGH
    precision highp float;
    #else
    precision mediump float;
    #endif

    uniform vec2 uRes;    // canvas size in device px
    uniform float uCell;  // grain cell size in device px (1 CSS px)
    uniform float uChaos;
    uniform float uGrain;
    uniform float uScroll; // page offset in viewport heights, already mod PERIOD

    const float PERIOD = ${PERIOD.toFixed(4)};
    const float TAU = 6.28318530718;

    // Dave Hoskins' sine-free hash
    float hash12(vec2 p) {
      vec3 p3 = fract(vec3(p.xyx) * 0.1031);
      p3 += dot(p3, p3.yzx + 33.33);
      return fract((p3.x + p3.y) * p3.z);
    }

    vec3 blob(vec3 col, vec2 p, vec3 c, vec2 at, vec2 r, float a) {
      float d = clamp(length((p - at) / r), 0.0, 1.0);
      return mix(col, c, a * (1.0 - smoothstep(0.0, 1.0, d)));
    }

    vec3 field(vec2 p) {
      // gentle domain warp so blob edges are organic, not elliptical
      // (y-driven term uses TAU / PERIOD so the warp repeats with the pattern)
      p += 0.1 * sin(vec2(TAU / PERIOD * p.y + 1.2, 2.6 * p.x + 2.04));

      vec3 col = vec3(0.039, 0.071, 0.133); // #0a1222
      // blobs reach ~0.75 beyond their centre, so neighbouring repeats overlap
      float k0 = floor(p.y / PERIOD);
      for (int i = -1; i <= 1; i++) {
        float oy = (k0 + float(i)) * PERIOD;
        col = blob(col, p, vec3(0.118, 0.196, 0.400), vec2(1.30, 0.10 + oy), vec2(0.95, 0.75), 0.70); // #1e3266
        col = blob(col, p, vec3(0.090, 0.145, 0.329), vec2(0.70, 0.45 + oy), vec2(0.80, 0.55), 0.35); // #172554
        col = blob(col, p, vec3(0.118, 0.196, 0.400), vec2(0.10, 1.00 + oy), vec2(0.85, 0.65), 0.45); // #1e3266, softer
        col = blob(col, p, vec3(0.008, 0.024, 0.090), vec2(1.50, 1.05 + oy), vec2(0.70, 0.55), 0.70); // #020617
      }
      return col;
    }

    void main() {
      vec2 uv = gl_FragCoord.xy / uRes;
      vec2 p = vec2(uv.x * 1.6, 1.0 - uv.y + uScroll);

      vec2 cell = floor(gl_FragCoord.xy / uCell);
      vec2 jitter = vec2(hash12(cell), hash12(cell + 17.31)) - 0.5;
      vec3 col = field(p + jitter * (uChaos / 2.0));

      col += (hash12(cell + 91.7) - 0.5) * (uGrain / 2.5);
      gl_FragColor = vec4(col, 1.0);
    }
  `;

  function initNoiseBackground() {
    const canvas = document.querySelector<HTMLCanvasElement>(".noise-bg__canvas");
    if (!canvas) return;

    const gl = canvas.getContext("webgl", {
      alpha: false,
      antialias: false,
      depth: false,
      stencil: false,
      powerPreference: "low-power",
    });
    if (!gl) return; // CSS gradient fallback stays visible

    function compile(type: number, src: string) {
      const s = gl!.createShader(type)!;
      gl!.shaderSource(s, src);
      gl!.compileShader(s);
      return s;
    }

    const prog = gl.createProgram()!;
    gl.attachShader(prog, compile(gl.VERTEX_SHADER, VERT));
    gl.attachShader(prog, compile(gl.FRAGMENT_SHADER, FRAG));
    gl.linkProgram(prog);
    if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) return;
    gl.useProgram(prog);

    // one oversized triangle covering the viewport
    gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
    const aPos = gl.getAttribLocation(prog, "aPos");
    gl.enableVertexAttribArray(aPos);
    gl.vertexAttribPointer(aPos, 2, gl.FLOAT, false, 0, 0);

    const uRes = gl.getUniformLocation(prog, "uRes");
    const uCell = gl.getUniformLocation(prog, "uCell");
    const uScroll = gl.getUniformLocation(prog, "uScroll");
    gl.uniform1f(gl.getUniformLocation(prog, "uChaos"), CHAOS);
    gl.uniform1f(gl.getUniformLocation(prog, "uGrain"), GRAIN);

    function draw() {
      const dpr = window.devicePixelRatio || 1;
      const cssH = canvas!.clientHeight;
      const w = Math.round(canvas!.clientWidth * dpr);
      const h = Math.round(cssH * dpr);
      if (!w || !h) return;

      if (canvas!.width !== w || canvas!.height !== h) {
        canvas!.width = w;
        canvas!.height = h;
        gl!.viewport(0, 0, w, h);
        gl!.uniform2f(uRes, w, h);
        gl!.uniform1f(uCell, Math.max(1, Math.round(dpr)));
      }

      // pattern is periodic, so wrap to keep shader coordinates small
      // (positive modulo also handles negative overscroll bounce)
      const pages = window.scrollY / cssH;
      gl!.uniform1f(uScroll, ((pages % PERIOD) + PERIOD) % PERIOD);
      gl!.drawArrays(gl!.TRIANGLES, 0, 3);
      canvas!.dataset.ready = "true";
    }

    let pending = false;
    function schedule() {
      if (pending) return;
      pending = true;
      requestAnimationFrame(() => {
        pending = false;
        draw();
      });
    }

    window.addEventListener("scroll", schedule, { passive: true });
    window.addEventListener("resize", schedule);

    draw();
  }

  initNoiseBackground();
</script>

<style>
  .noise-bg {
    position: fixed;
    top: 0;
    left: 0;
    z-index: -20;
    width: 100%;
    /* large viewport height: mobile URL bar show/hide doesn't trigger re-renders */
    height: 100vh;
    height: 100lvh;
    pointer-events: none;
    /* fallback ≈ same blobs (CSS lists top layer first; alpha follows smoothstep) */
    background:
      radial-gradient(43.75% 55% at 93.75% 105%, rgba(2, 6, 23, 0.7), rgba(2, 6, 23, 0.35) 50%, transparent),
      radial-gradient(53.1% 65% at 6.25% 100%, rgba(30, 50, 102, 0.45), rgba(30, 50, 102, 0.22) 50%, transparent),
      radial-gradient(50% 55% at 43.75% 45%, rgba(23, 37, 84, 0.35), rgba(23, 37, 84, 0.18) 50%, transparent),
      radial-gradient(59.4% 75% at 81.25% 10%, rgba(30, 50, 102, 0.7), rgba(30, 50, 102, 0.35) 50%, transparent),
      #0a1222;
  }

  .noise-bg__canvas {
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.6s ease-out;
  }

  .noise-bg__canvas[data-ready] {
    opacity: 1;
  }
</style>
