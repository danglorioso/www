      <h3 class="pq-routes-heading">Inside the API</h3>
      <p class="pq-routes-sub">60 routes, grouped by their purpose.</p>
      <div class="pq-api-explorer">
        <div class="pq-api-tabs" role="tablist" aria-label="API route categories">
          {apiRoutes.map((route, i) => (
            <button
              type="button"
              class="pq-api-tab"
              role="tab"
              aria-selected={i === 0 ? "true" : "false"}
              aria-controls={`pq-api-pane-${i}`}
              id={`pq-api-tab-${i}`}
              data-api-tab={i}
            >
              <span class="pq-api-tab-icon" set:html={`<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">${ROUTE_ICONS[route.icon]}</svg>`} />
              {route.label}
            </button>
          ))}
        </div>

        <div class="pq-api-panel">
          <div class="pq-api-panel-bar">
            <span class="pq-api-dot pq-api-dot-red"></span>
            <span class="pq-api-dot pq-api-dot-yellow"></span>
            <span class="pq-api-dot pq-api-dot-green"></span>
            <span class="pq-api-panel-title">routes.ts</span>
          </div>
          <div class="pq-api-panel-body">
            {apiRoutes.map((route, i) => (
              <div
                class:list={["pq-api-pane", { "is-active": i === 0 }]}
                role="tabpanel"
                id={`pq-api-pane-${i}`}
                aria-labelledby={`pq-api-tab-${i}`}
                data-api-pane={i}
              >
                {route.descHtml ? (
                  <p class="pq-api-desc" set:html={route.descHtml} />
                ) : (
                  <p class="pq-api-desc">{route.desc}</p>
                )}
                <ul class="pq-api-endpoints">
                  {route.endpoints.map((ep) => (
                    <li>
                      <span class="pq-api-methods">
                        {(ep.methods ?? [ep.method as string]).map((m: string) => (
                          <span class={`pq-api-method pq-api-method-${m.toLowerCase()}`}>{m}</span>
                        ))}
                      </span>
                      {ep.descHtml ? (
                        <span class="pq-api-endpoint-desc" set:html={ep.descHtml} />
                      ) : (
                        <span class="pq-api-endpoint-desc">{ep.desc}</span>
                      )}
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
