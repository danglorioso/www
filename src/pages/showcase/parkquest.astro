        <div class="pq-phone-carousel-track" id="pq-phone-carousel-track">
          {Array.from({ length: 2 }).map(() =>
            carouselSlides.map((slide) => (
              <div class="pq-mini-phone">
                <div class="pq-mini-phone-screen">
                  {slide.video ? (
                    <video src={slide.src} autoplay muted loop playsinline preload="metadata"></video>
                  ) : (
                    <img src={slide.src} alt={slide.alt} loading="lazy" />
                  )}
                </div>
                <div class="pq-mini-phone-outline" set:html={iphoneOutline} />
              </div>
            ))
          )}
        </div>
      </div>
    </section>

