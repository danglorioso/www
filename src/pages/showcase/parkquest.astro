              class="pq-ca-state"
            />
            <path class="pq-ca-route" d={caRoute} />
            <g class="pq-ca-pins">
              {caParks.map((p) => (
                <g>
                  <circle class="pq-ca-pin-halo" cx={p.cx} cy={p.cy} r="6.5" />
                  <circle class="pq-ca-pin" cx={p.cx} cy={p.cy} r="3.2" />
                </g>
              ))}
            </g>
            <g class="pq-ca-labels">
              {caParks.map((p) => (
                <text class="pq-ca-label" x={p.lx} y={p.ly} text-anchor={p.anchor}>{p.name}</text>
              ))}
            </g>
          </svg>
          <p class="pq-map-caption">The tallest trees in the world, the lowest point in North America, and an active volcano &mdash; all in one state.</p>
