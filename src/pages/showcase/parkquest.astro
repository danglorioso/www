  /* Carries the hero's night straight into the origin story, then lets
     it fade into the forest green of .pq-inside below — a continuous
     sky-to-woods block rather than hero-dark / origin-light /
     inside-dark banding. Gradient endpoints are pinned to match: starts
     at the hero's own closing tone (--pq-night) and ends at pq-bg-1,
     which is exactly where .pq-inside::before begins. */
  .pq-origin {
    position: relative;
  }
  .pq-origin::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 100vw;
    transform: translateX(-50%);
    /* Night holds through the top half, then one long fade straight from
       navy to the forest green .pq-inside starts on — a single blended
       stop in between (not a detour through the near-black bg-0) so the
       hue shifts once, slowly, instead of banding through three colours. */
    background: linear-gradient(
      180deg,
      var(--pq-night) 0%,
      var(--pq-night) 42%,
      color-mix(in oklab, var(--pq-night) 55%, var(--pq-bg-1)) 72%,
      var(--pq-bg-1) 100%
    );
    z-index: -1;
  }

  /* Star field over the navy band — masked out gradually as the gradient
     turns green, so the stars read as part of the night sky rather than
     floating in the forest. Each star's size, peak brightness and twinkle
     timing come from the originStars data (inline custom properties). */
  .pq-origin-stars {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    color: var(--pq-gold-soft);
    -webkit-mask-image: linear-gradient(180deg, black 0%, black 38%, transparent 68%);
    mask-image: linear-gradient(180deg, black 0%, black 38%, transparent 68%);
    pointer-events: none;
    z-index: -1;
  }
  .pq-origin-star {
    animation: pq-twinkle var(--dur, 4s) ease-in-out var(--delay, 0s) infinite;
  }
  @media (prefers-reduced-motion: reduce) {
    .pq-origin-star { animation: none; opacity: var(--pq-star-max, 0.6); }
  }

  .pq-origin h2 {
    color: var(--pq-cream);
  }

  .pq-origin-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }
  @media (min-width: 900px) {
    .pq-origin-grid {
      grid-template-columns: 1.1fr 0.9fr;
    }
  }

  .pq-origin-text p {
    color: var(--pq-mute);
    font-size: 1.05rem;
    line-height: 1.7;
    margin-bottom: 1.25rem;
  }

  .pq-origin-map {
    color: var(--pq-gold);
    text-align: center;
  }
  .pq-origin-map svg {
    width: 100%;
    max-width: 340px;
    margin: 0 auto;
    overflow: visible;
    filter: drop-shadow(0 12px 28px rgba(0, 0, 0, 0.4));
  }
  .pq-ca-state {
    fill: currentColor;
    fill-opacity: 0.08;
    stroke: currentColor;
    stroke-opacity: 0.8;
    stroke-width: 1.5;
    stroke-linejoin: round;
  }
  .pq-ca-route {
    fill: none;
    stroke: var(--pq-gold-soft);
    stroke-opacity: 0.55;
    stroke-width: 1.25;
    stroke-dasharray: 3 4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .pq-ca-pin-halo {
    fill: var(--pq-gold);
    fill-opacity: 0.2;
  }
  .pq-ca-pin {
    fill: var(--pq-gold-soft);
    stroke: var(--pq-bg-0);
    stroke-width: 1.5;
  }
  /* Cartographic halo instead of label chips: a dark stroke painted under
     the glyphs knocks out whatever line runs beneath the text, so labels
     stay legible over the outline and route without boxing each one. */
  .pq-ca-label {
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.07em;
    fill: var(--pq-cream);
    paint-order: stroke;
    stroke: var(--pq-bg-0);
    stroke-width: 2.6px;
    stroke-linejoin: round;
    stroke-opacity: 0.85;
  }
  .pq-map-caption {
    margin-top: 1rem;
    font-size: 0.85rem;
    color: var(--pq-mute);
  }

  /* What's inside — matches the reference bento mockup's own dark-green
     card backgrounds and box ordering (hero tile + parks up top, then
     log/gpx/stamp, then bucket/friends), via named grid-areas so the
     ordering is explicit rather than inferred from span/order tricks.
     Full-bleed dark forest green section background — the page's navy
     didn't read well behind the green cards, so this section gets its
     own backdrop instead of inheriting the page's. */
  .pq-inside {
    position: relative;
  }
  .pq-inside::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 100vw;
    transform: translateX(-50%);
    background: linear-gradient(180deg, var(--pq-bg-1) 0%, var(--pq-bg-0) 100%);
    z-index: -1;
  }
  .pq-inside-grid {
    display: grid;
    grid-template-columns: 1fr;
    grid-template-areas:
      "hero"
      "parks"
      "log"
      "gpx"
      "stamp"
      "buck"
      "frnds";
    gap: 1rem;
  }
  @media (min-width: 700px) {
    .pq-inside-grid {
      grid-template-columns: repeat(6, 1fr);
      grid-template-areas:
        "hero hero hero hero hero hero"
        "parks parks parks log log log"
        "gpx gpx gpx gpx stamp stamp"
        "buck buck buck frnds frnds frnds";
    }
  }
  @media (min-width: 1100px) {
    .pq-inside-grid {
      grid-template-columns: repeat(12, 1fr);
      grid-template-areas:
        "hero hero hero hero hero hero hero parks parks parks parks parks"
        "log log log log gpx gpx gpx gpx stamp stamp stamp stamp"
        "buck buck buck buck buck frnds frnds frnds frnds frnds frnds frnds";
    }
  }
  .pq-area-hero { grid-area: hero; }
  .pq-area-parks { grid-area: parks; }
  .pq-area-log { grid-area: log; }
  .pq-area-gpx { grid-area: gpx; }
  .pq-area-stamp { grid-area: stamp; }
  .pq-area-buck { grid-area: buck; }
  .pq-area-frnds { grid-area: frnds; }

  .pq-inside-card {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.9rem;
    padding: 1.75rem;
    outline: 1px solid rgba(240, 234, 219, 0.1);
    outline-offset: 0;
    border-radius: 1.25rem;
    background: linear-gradient(165deg, #182a1e, #0e1811);
    box-shadow: inset 0 3px 6px rgba(255, 255, 255, 0.045), 0 14px 34px rgba(0, 0, 0, 0.35);
    transition: outline-color 0.2s ease;
  }
  .pq-inside-card:hover {
    outline-color: color-mix(in oklab, var(--pq-gold) 45%, rgba(240, 234, 219, 0.1));
  }
  .pq-inside-card h3 {
    margin: 0;
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.15;
    color: var(--text-primary);
  }
  .pq-inside-card p {
    margin: 0;
    color: var(--text-tertiary);
    font-size: 0.92rem;
    line-height: 1.55;
  }

  .pq-area-hero {
    justify-content: flex-end;
    padding: 2rem;
    background-image:
      radial-gradient(120% 130% at 82% 8%, color-mix(in oklab, var(--pq-gold) 22%, transparent) 0%, transparent 52%),
      linear-gradient(165deg, #1f3d2e, #0c1811 70%);
  }
  .pq-area-hero > *:not(.pq-ridge) {
    position: relative;
    z-index: 1;
  }
  .pq-hero-title {
    font-size: clamp(1.9rem, 3.6vw, 2.75rem) !important;
    line-height: 1.03 !important;
    letter-spacing: -0.03em !important;
  }
  .pq-area-hero p {
    max-width: 34ch;
  }
  .pq-ridge {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 44%;
    pointer-events: none;
  }

  /* What's inside — mini visuals per card, adapted from a bento mockup the
     user supplied. */
  .pq-dotgrid {
    display: grid;
    grid-template-columns: repeat(21, 1fr);
    gap: 4px;
    margin-top: 0.25rem;
  }
  .pq-dot {
    aspect-ratio: 1;
    border-radius: 2px;
    background: color-mix(in oklab, var(--text-tertiary) 25%, transparent);
  }
  .pq-dot-visited {
    background: #6fae7c;
  }
  .pq-dot-bucket {
    background: transparent;
    box-shadow: inset 0 0 0 1.5px var(--pq-gold);
  }

  .pq-steps {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }
  .pq-step {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 0.72rem;
    letter-spacing: 0.02em;
    color: var(--text-tertiary);
  }
  .pq-step em {
    flex: none;
    width: 1.1rem;
    height: 1.1rem;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-style: normal;
    font-size: 0.6rem;
    background: color-mix(in oklab, var(--text-tertiary) 15%, transparent);
    color: var(--text-tertiary);
  }
  .pq-step-on {
    color: var(--text-primary);
  }
  .pq-step-on em {
    background: var(--pq-gold);
    color: #1a1408;
  }
  .pq-stars {
    color: var(--pq-gold);
    font-size: 0.8rem;
    letter-spacing: 0.1rem;
  }

  .pq-gpxrow {
    display: flex;
    align-items: flex-end;
    gap: 1.5rem;
  }
  .pq-gpxstat b {
    display: block;
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1;
  }
  .pq-gpxstat b small {
    font-size: 0.8rem;
    font-weight: 400;
    color: var(--text-tertiary);
    margin-left: 0.15em;
  }
  .pq-gpxstat span {
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-tertiary);
  }
  .pq-gpxprofile {
    flex: 1;
    min-width: 5rem;
    height: 2.75rem;
    color: var(--pq-gold);
  }

  .pq-qlist {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--text-tertiary);
  }
  .pq-qlist li {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }
  .pq-qlist svg {
    flex: none;
    width: 0.8rem;
    height: 0.9rem;
    fill: color-mix(in oklab, var(--pq-gold) 20%, transparent);
    stroke: var(--pq-gold);
    stroke-width: 1.6;
    stroke-linejoin: round;
  }

  .pq-stamprow {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .pq-seal {
    flex: none;
    width: 4rem;
    height: 4rem;
    display: grid;
    place-items: center;
  }
  .pq-seal svg {
    width: 100%;
    height: 100%;
  }
  .pq-badgedots {
    display: flex;
    gap: 0.45rem;
    flex-wrap: wrap;
  }
  .pq-badgedots i {
    width: 1.35rem;
    height: 1.35rem;
    border-radius: 50%;
    display: block;
  }

  .pq-frow {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin-top: 0.5rem;
  }
  .pq-avs {
    display: flex;
    flex: none;
    /* Scope the negative z-index below to this stack's own stacking
       context — otherwise it escapes to the card's background instead of
       just tucking behind the neighboring avatar. */
    isolation: isolate;
  }
  .pq-avs i {
    width: 1.9rem;
    height: 1.9rem;
    border-radius: 50%;
    border: 2px solid #16281c;
    margin-left: -0.6rem;
    display: grid;
    place-items: center;
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 0.6rem;
    font-style: normal;
    color: #12210f;
  }
  .pq-avs i:first-child {
    margin-left: 0;
  }
  .pq-avs-more {
    background: color-mix(in oklab, var(--text-tertiary) 20%, transparent);
    color: var(--text-tertiary) !important;
    z-index: -1;
  }
  .pq-frow-note {
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 0.7rem;
    color: var(--text-tertiary);
    line-height: 1.4;
    margin: 0;
  }

  /* Pinned feature scroller */
  .pq-features {
    max-width: none;
    padding: 0;
  }
  .pq-feature-grid {
    max-width: 72rem;
    margin: 0 auto;
    padding: 4rem 2rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }
  @media (max-width: 640px) {
    .pq-feature-grid {
      padding: 3rem 1.25rem;
      gap: 2.5rem;
    }
  }
  @media (min-width: 900px) {
    .pq-feature-grid {
      grid-template-columns: 0.9fr 1.1fr;
      gap: 4rem;
    }
  }

  .pq-phone-stage {
    position: relative;
    display: flex;
    justify-content: center;
  }
  @media (min-width: 900px) {
    .pq-phone-stage {
      align-self: start;
    }
  }

  .pq-phone {
    position: relative;
    /* min() instead of a flat 300px — on narrow viewports (~360px and
       below), 300px plus the section's 2rem side padding no longer fits
       and pushed the page into horizontal scroll. */
    width: min(300px, 100%);
    /* Kept at the trace SVG's native ratio on purpose — stretching this
       non-uniformly (with preserveAspectRatio="none") turns the bezel's
       circular corners into ellipses that a plain CSS border-radius can't
       match, leaving a visible gap at the top corners. Not worth it. */
    aspect-ratio: 1350 / 2760;
    filter: drop-shadow(0 30px 40px rgba(0, 0, 0, 0.6));
  }
  /* Below 900px the phone and captions stack and pin as one block (see the
     script) instead of sitting pinned side by side — so the phone also has
     to leave room for the caption underneath it within a single screen's
     height. Capping width by vh (not just px/vw) scales the phone — and so
     its height, via the fixed aspect-ratio — down on shorter viewports and
     up on taller ones, instead of one fixed size that fits some phones and
     not others. */
  @media (max-width: 899px) {
    .pq-phone {
      width: min(300px, 100%, 24vh);
    }
  }
  /* Nudge that this is a pinned, scroll-scrubbed section, not a stuck page —
     shows up if the user pauses mid-sequence (JS toggles .is-visible) and
     hides the instant they scroll again or finish the sequence. */
  .pq-keep-scrolling {
    position: absolute;
    left: 50%;
    /* top is set from JS — tracks the bottom edge of whichever caption's
       text is currently active, since captions vary a lot in length and
       are vertically centered in their box (so their own bottom edge
       moves too), rather than sitting at one fixed spot below the stage. */
    top: 0;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.7rem;
    background: none;
    border: none;
    font-family: inherit;
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    white-space: nowrap;
    color: var(--pq-gold-soft);
    opacity: 0;
    transition: opacity 0.4s ease, top 0.3s ease, color 0.2s ease;
    pointer-events: none;
  }
  .pq-keep-scrolling svg {
    width: 18px;
    height: 18px;
  }
  .pq-keep-scrolling.is-visible {
    opacity: 1;
    pointer-events: auto;
    cursor: pointer;
  }
  .pq-keep-scrolling.is-visible svg {
    animation: pq-hint-bob 1.6s ease-in-out infinite;
  }
  .pq-keep-scrolling.is-visible:hover {
    color: var(--pq-gold);
  }
  @keyframes pq-hint-bob {
    0%, 100% { transform: translateY(0); opacity: 1; }
    50% { transform: translateY(6px); opacity: 0.45; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pq-keep-scrolling.is-visible svg { animation: none; }
  }
  /* Shows once the active screen's video plays through to the end (Apple-
     style "replay" link), hides again the moment the screen changes. */
  .pq-replay {
    position: absolute;
    left: 50%;
    bottom: -1.6rem;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 0.4rem;
    background: none;
    border: none;
    padding: 0;
    font-family: inherit;
    font-size: 0.85rem;
    letter-spacing: 0.02em;
    color: var(--pq-gold-soft);
    cursor: pointer;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease, color 0.2s ease;
  }
  .pq-replay.is-visible {
    opacity: 1;
    pointer-events: auto;
  }
  .pq-replay:hover {
    color: var(--pq-gold);
  }
  .pq-replay-icon {
    width: 15px;
    height: 15px;
  }
  /* Bounding box of the real screen cutout in iphone-trace.svg; the outline
     overlay below draws the precise curved edge on top of this rectangle. */
  .pq-phone-screen-hole {
    position: absolute;
    /* The outline SVG's own silhouette doesn't reach the very edges of its
       viewBox on either end — pixel-scanning the rendered trace found a
       ~1% margin at the top and ~1.2% at the bottom before the frame art
       actually starts/stops. Content can't cross either or it shows
       through the transparent margin, past the frame entirely, against
       the page background — not miscropped, genuinely outside the phone. */
    top: 2.2%;
    /* Widened past the 4.1% that exactly matches content aspect at the
       original top+bottom budget (2.6%) — more margin on both edges needs
       more combined budget (now 4%), and the only way to keep the same
       0.461 content aspect at a bigger budget is a narrower box. */
    left: 4.8%;
    right: 4.8%;
    bottom: 1.8%;
    /* Rounded well past what the frame's own curve strictly needs, on
       purpose — the bezel is a hand trace, not a perfect arc, and erring
       toward "tucked further behind the frame" is a much safer failure
       mode than content poking past the visible corner. */
    border-radius: 3rem;
    overflow: hidden;
    background: #050505;
  }
  .pq-phone-outline {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 2;
  }
  .pq-phone-screen {
    position: relative;
    width: 100%;
    height: 100%;
  }
  .pq-screen {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: var(--pq-gold);
  }
  .pq-screen-2, .pq-screen-3, .pq-screen-4, .pq-screen-5, .pq-screen-6 {
    /* hidden by default; JS controls visibility as the pinned scroll advances */
    opacity: 0;
    visibility: hidden;
  }
  .pq-screen-label {
    position: absolute;
    top: 1.5rem;
    left: 50%;
    transform: translateX(-50%);
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-secondary);
    opacity: 0.6;
  }
  .pq-screen-svg {
    width: 85%;
    height: auto;
  }
  .pq-screen-media {
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: #050505;
  }

  /* Captions overlap and crossfade in place (like the phone's own screens)
     instead of stacking in normal flow — that's what lets the active one
     stay centered regardless of how much text it holds. At 900px+ this
     sits beside the phone and is pinned separately (JS sets this box's
     height to match .pq-phone's real height so both land at the same
     pinned top offset and land centered together); below 900px it stacks
     under the phone and rides along in the same single pinned block
     instead (see the script). */
  .pq-captions-stage {
    position: relative;
    width: 100%;
    /* .pq-captions is now sized to its own content (see below), shorter
       than this stage's full (phone-matched) height — center it within
       that extra space rather than stretching to fill it. */
    display: flex;
    align-items: center;
    justify-content: center;
  }
  @media (min-width: 900px) {
    .pq-captions-stage {
      align-self: start;
    }
  }
  .pq-captions {
    position: relative;
    width: 100%;
    /* JS measures the tallest caption's natural content height and sets
       this explicitly — was height:100% of the phone-matched stage
       (~20rem/600px+), which meant a slide had to travel that whole
       distance to clear the box even though the text itself only runs
       a few lines. This min-height is just the pre-JS/reduced-motion
       fallback floor — kept under the real measured height (~10rem) so
       it doesn't override JS back up to something taller. */
    min-height: 9rem;
    /* Captions now slide in/out on the Y axis (reel/detent effect) instead
       of crossfading in place — clip so the outgoing/incoming caption's
       travel through the box never spills past its edges. */
    overflow: hidden;
  }
  @media (max-width: 899px) {
    .pq-captions {
      min-height: 8rem;
    }
  }
  .pq-caption {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    /* No bottom — height is intrinsic to the text content instead of
       stretched to fill the (much taller) parent, so .pq-captions above
       can measure and size itself to just that. */
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 1rem;
  }
  .pq-caption:not(.pq-caption-1) {
    opacity: 0;
    visibility: hidden;
  }
  .pq-caption h3 {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.75rem;
  }
  .pq-caption-icon {
    width: 1.5rem;
    height: 1.5rem;
    flex-shrink: 0;
    color: var(--pq-gold);
  }
  .pq-caption p {
    color: var(--text-tertiary);
    font-size: 1.05rem;
    line-height: 1.6;
    max-width: 26rem;
  }
  .pq-caption p + p {
    margin-top: 0.75rem;
  }
  /* Below 900px, phone + captions stack and pin as one screen-height block
     (see the script) — on a short viewport (iPhone SE and similar), the
     two-paragraph captions no longer fit under even a floored-down phone,
     and the pin (which freezes page scroll) leaves the overflow
     permanently below the fold with no way to reach it. Tighter type on
     short viewports keeps the whole caption inside that budget instead. */
  @media (max-width: 899px) and (max-height: 740px) {
    .pq-caption h3 {
      font-size: 1.2rem;
      margin-bottom: 0.4rem;
    }
    .pq-caption p {
      font-size: 0.9rem;
      line-height: 1.4;
    }
    .pq-caption p + p {
      margin-top: 0.45rem;
    }
  }

  /* Slide-position dots — hugs the true right edge of the viewport via
     plain position:fixed (not tied to the grid's own max-width/centering,
     which leaves a big variable gap on wide screens and almost none on
     medium ones), shown only while the pinned scroller is actually active
     (JS toggles .is-visible off tl's own ScrollTrigger.isActive). */
  .pq-slide-dots {
    position: fixed;
    top: 50%;
    right: 1rem;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
    z-index: 20;
  }
  .pq-slide-dots.is-visible {
    opacity: 1;
  }
  /* Below 900px the captions column runs nearly full viewport width with
     centered text close to its own edges, and there's no side-by-side gap
     to sit in — the dots only show once that layout is in play. */
  @media (max-width: 899px) {
    .pq-slide-dots {
      display: none;
    }
  }
  .pq-slide-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--text-tertiary);
    opacity: 0.35;
    transition: opacity 0.3s ease, background 0.3s ease, transform 0.3s ease;
  }
  .pq-slide-dot.is-active {
    background: var(--pq-gold);
    opacity: 1;
    transform: scale(1.4);
  }

  /* Phone carousel */
  .pq-carousel-section {
    padding: 2rem 0 6rem;
    overflow: hidden;
  }
  .pq-phone-carousel {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
  }
  .pq-phone-carousel-track {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    width: max-content;
    /* Duration scaled with the track's width (currently 34 unique slides)
       to keep the drift speed in px/s roughly constant. */
    animation: pq-carousel-drift 160s linear infinite;
  }
  @keyframes pq-carousel-drift {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .pq-phone-carousel-track { animation: none; }
  }

  .pq-mini-phone {
    position: relative;
    flex: none;
    width: 170px;
    aspect-ratio: 1350 / 2760;
    /* Tighter and softer than before — at a bigger blur/opacity this read
       as a rectangular dark-blue smudge behind each phone rather than a
       shadow hugging the rounded shape. */
    filter: drop-shadow(0 8px 10px rgba(0, 0, 0, 0.3));
  }
  .pq-mini-phone-screen {
    position: absolute;
    top: 1.7%;
    left: 4.8%;
    right: 4.8%;
    bottom: 1.8%;
    /* Rounded a bit past what the bezel's own corner curve strictly needs
       (same margin-of-safety approach as the main phone mockup) — a
       screenshot's square corner peeking past the bezel's rounded mask
       used to show as a mismatched dark square. Background matched to
       the page itself so even a stray sliver blends in instead of
       contrasting as a different shade of "dark". */
    border-radius: 2.1rem;
    overflow: hidden;
    background: var(--bg-primary);
  }
  .pq-mini-phone-screen img,
  .pq-mini-phone-screen video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .pq-mini-phone-outline {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  /* By the numbers */
  .pq-stats {
    padding-top: 3rem;
    padding-bottom: 3rem;
  }
  .pq-stats-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2.5rem;
    text-align: center;
  }
  @media (min-width: 700px) {
    .pq-stats-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .pq-stat-num {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 800;
    color: var(--pq-gold);
    margin-bottom: 0.5rem;
  }
  .pq-stat-label {
    font-size: 0.85rem;
    color: var(--text-tertiary);
    line-height: 1.4;
  }

  /* Built with — left column (stack + diagram) vs. right column (shared
     types reference) so the disjoint types card reads as sitting beside
     everything else, not just some leftover bolted onto the diagram. */
  .pq-bts-row {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }
  .pq-bts-left {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    min-width: 0;
  }
  @media (min-width: 1300px) {
    .pq-bts-row {
      flex-direction: row;
      align-items: flex-start;
    }
    .pq-bts-left {
      flex: 1 1 auto;
    }
    .pq-types-card {
      flex: 0 0 260px;
    }
  }
  .pq-diagram {
    position: relative;
    color: var(--pq-gold);
    overflow-x: auto;
  }
  .pq-types-card {
    padding: 1.25rem 1.25rem 1.4rem;
    border: 1px solid var(--border-primary);
    border-radius: 0.9rem;
    background: var(--bg-card);
  }
  .pq-types-title {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.9rem;
  }
  .pq-types-row {
    padding: 0.6rem 0;
    border-top: 1px solid var(--border-primary);
  }
  .pq-types-row:first-of-type {
    border-top: none;
  }
  .pq-types-label {
    display: block;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--pq-gold-soft);
    margin-bottom: 0.3rem;
  }
  .pq-types-list {
    display: block;
    font-size: 0.8rem;
    line-height: 1.5;
    color: var(--text-tertiary);
  }
  .pq-types-list code {
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 0.9em;
    color: var(--text-secondary);
  }
  /* Hover a box (or its label) to spotlight its own path through the
     diagram — everything else dims instead. Quiet on purpose: no ambient
     motion, nothing until you actually interact with it. */
  .pq-diagram-svg [data-group] {
    transition: opacity 0.25s ease;
  }
  .pq-diagram-svg.pq-diagram-hovering [data-group] {
    opacity: 0.2;
  }
  .pq-diagram-svg.pq-diagram-hovering [data-group].is-active {
    opacity: 1;
  }
  .pq-diagram-hits rect {
    cursor: pointer;
    pointer-events: all;
  }
  @media (max-width: 700px) {
    .pq-diagram::after {
      content: "";
      position: absolute;
      inset: 0 0 0 auto;
      width: 2.5rem;
      background: linear-gradient(to right, transparent, var(--bg-primary));
      pointer-events: none;
    }
  }
  .pq-diagram-svg {
    width: 100%;
    min-width: 800px;
  }
  /* Card-style boxes, rounded like the rest of the page (not the earlier
     sharp/blueprint experiment) — colour lives entirely in each tier's flat
     fill and icon chip now, not in the text, which stays cream/mute
     everywhere (see the text rules below). Borders thicker and lighter
     than a typical hairline on purpose — this is the one place on the page
     where the border needs to read at a glance, not just delineate. */
  .pq-diagram-node-client rect {
    fill: color-mix(in oklab, var(--pq-bg-2) 88%, var(--pq-diagram-service) 12%);
    stroke: var(--pq-mute);
    stroke-opacity: 0.55;
    stroke-width: 2;
  }
  .pq-diagram-node-api rect {
    fill: color-mix(in oklab, var(--pq-gold) 18%, var(--pq-bg-1));
    stroke: var(--pq-gold);
    stroke-opacity: 0.95;
    stroke-width: 2.2;
  }
  .pq-diagram-node-service rect {
    fill: var(--pq-bg-1);
    stroke: var(--pq-mute);
    stroke-opacity: 0.45;
    stroke-width: 1.8;
  }
  /* Every title and every body line share the same two colours regardless
     of tier — hierarchy comes from weight/opacity, not from re-coloring
     text per box, which is what made earlier passes here feel inconsistent. */
  .pq-diagram-svg text[font-weight="700"] {
    color: var(--pq-cream);
  }
  .pq-diagram-svg text:not([font-weight="700"]) {
    color: var(--pq-mute);
  }

  /* App Store Connect reconciliation diagram — same two-tier fill
     convention as the main architecture diagram (gold = our code,
     hairline-mute = a backing service), just a small static flow instead
     of the big hoverable one. Reuses that diagram's arrowhead marker,
     which is fine — marker ids resolve document-wide, not per-<svg>. */
  .pq-recon-diagram {
    position: relative;
    overflow-x: auto;
    margin: 1.5rem 0;
  }
  .pq-recon-diagram-svg {
    width: 100%;
    min-width: 480px;
  }
  .pq-recon-node-ours rect {
    fill: color-mix(in oklab, var(--pq-gold) 18%, var(--pq-bg-1));
    stroke: var(--pq-gold);
    stroke-opacity: 0.95;
    stroke-width: 2;
  }
  .pq-recon-node-service rect {
    fill: var(--pq-bg-1);
    stroke: var(--pq-mute);
    stroke-opacity: 0.45;
    stroke-width: 1.8;
  }
  @media (max-width: 700px) {
    .pq-recon-diagram::after {
      content: "";
      position: absolute;
      inset: 0 0 0 auto;
      width: 2rem;
      background: linear-gradient(to right, transparent, var(--bg-card));
      pointer-events: none;
    }
  }
  .pq-recon-caption {
    color: var(--text-tertiary);
    font-size: 0.9rem;
    line-height: 1.6;
  }
  .pq-recon-caption code {
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 0.9em;
    color: var(--text-secondary);
  }

  .pq-routes-heading {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.4rem;
  }
  .pq-routes-sub {
    font-size: 0.9rem;
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
  }
  /* Admin tools list — a settings-style row list (icon, label, description
     on one hairline-divided line) rather than a card grid. Reads like the
     dashboard's own nav rather than a generic feature grid. */
  .pq-admin-tool-list {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--border-primary);
    margin-bottom: 2.5rem;
  }
  .pq-admin-tool-row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    column-gap: 0.9rem;
    row-gap: 0.3rem;
    padding: 0.85rem 0.1rem;
    border-bottom: 1px solid var(--border-primary);
  }
  .pq-admin-tool-head {
    flex: 0 0 auto;
    width: 7.4rem;
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }
  .pq-admin-tool-icon {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.15rem;
    height: 1.15rem;
    color: var(--pq-gold);
  }
  .pq-admin-tool-label {
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--text-primary);
  }
  .pq-admin-tool-desc {
    flex: 1 1 12rem;
    font-size: 0.86rem;
    line-height: 1.55;
    color: var(--text-tertiary);
    padding-top: 0.05rem;
  }

  /* "Inside the API" as a tabbed code-editor mockup instead of a static
     grid — click a category, the panel below swaps to its real-shaped
     endpoints. More fun to poke at than a wall of cards, and the endpoint
     paths are concrete detail a static list didn't have room for. */
  .pq-api-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 1.1rem;
  }
  .pq-api-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.95rem;
    border-radius: 999px;
    border: 1px solid var(--border-primary);
    background: var(--bg-card);
    color: var(--text-tertiary);
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease, transform 0.15s ease;
  }
  .pq-api-tab:hover {
    border-color: color-mix(in oklab, var(--pq-gold) 45%, var(--border-primary));
    color: var(--text-primary);
    transform: translateY(-1px);
  }
  .pq-api-tab:focus-visible {
    outline: 2px solid var(--pq-gold);
    outline-offset: 2px;
  }
  .pq-api-tab[aria-selected="true"] {
    background: var(--pq-gold);
    border-color: var(--pq-gold);
    color: #1a1408;
  }
  .pq-api-tab[aria-selected="true"] .pq-api-tab-icon {
    color: #1a1408;
  }
  .pq-api-tab-icon {
    display: inline-flex;
    width: 1rem;
    height: 1rem;
    color: var(--pq-gold);
  }
  @media (prefers-reduced-motion: reduce) {
    .pq-api-tab {
      transition: none;
    }
    .pq-api-tab:hover {
      transform: none;
    }
  }

  .pq-api-panel {
    border: 1px solid var(--border-primary);
    border-radius: 0.9rem;
    background: var(--bg-card);
    overflow: hidden;
  }
  .pq-api-panel-bar {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.7rem 1rem;
    border-bottom: 1px solid var(--border-primary);
    background: color-mix(in oklab, black 12%, var(--bg-card));
  }
  .pq-api-dot {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
  }
  .pq-api-dot-red {
    background: #ff5f56;
    opacity: 0.55;
  }
  .pq-api-dot-yellow {
    background: #ffbd2e;
    opacity: 0.55;
  }
  .pq-api-dot-green {
    background: #27c93f;
    opacity: 0.55;
  }
  .pq-api-panel-title {
    margin-left: 0.5rem;
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 0.78rem;
    color: var(--text-tertiary);
  }
  .pq-api-panel-body {
    padding: 1.5rem 1.5rem 1.75rem;
    min-height: 12.5rem;
  }
  .pq-api-pane {
    display: none;
  }
  .pq-api-pane.is-active {
    display: block;
    animation: pq-api-fade 0.25s ease;
  }
  @keyframes pq-api-fade {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pq-api-pane.is-active {
      animation: none;
    }
  }
  .pq-api-desc {
    color: var(--text-tertiary);
    font-size: 0.92rem;
    line-height: 1.6;
    margin-bottom: 1.1rem;
  }
  .pq-api-desc code {
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 0.9em;
    color: var(--text-secondary);
  }
  .pq-api-endpoints {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }
  .pq-api-endpoints li {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  @media (min-width: 480px) {
    .pq-api-endpoints li {
      flex-direction: row;
      align-items: flex-start;
      gap: 0.85rem;
    }
  }
  .pq-api-methods {
    display: flex;
    flex: 0 0 auto;
    flex-wrap: nowrap;
    gap: 0.3rem;
  }
  .pq-api-endpoint-desc {
    font-size: 0.86rem;
    line-height: 1.5;
    color: var(--text-secondary);
    padding-top: 0.15rem;
  }
  .pq-api-endpoint-desc code {
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 0.9em;
    color: var(--text-secondary);
  }
  .pq-api-method {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 3.5rem;
    padding: 0.18rem 0.5rem;
    border-radius: 0.35rem;
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }
  .pq-api-method-get {
    background: color-mix(in oklab, #6fb3e0 20%, transparent);
    color: #8fc7ec;
  }
  .pq-api-method-patch {
    background: color-mix(in oklab, #b39ddb 20%, transparent);
    color: #c9b6ea;
  }
  .pq-api-method-delete {
    background: color-mix(in oklab, #e08787 20%, transparent);
    color: #eba3a3;
  }
  .pq-api-method-post {
    background: color-mix(in oklab, var(--pq-gold) 20%, transparent);
    color: var(--pq-gold);
  }
  .pq-api-method-put {
    background: color-mix(in oklab, #7fc9a3 20%, transparent);
    color: #9edcbb;
  }

  .pq-algo-intro {
    color: var(--text-tertiary);
    font-size: 1rem;
    line-height: 1.6;
    max-width: 52rem;
    margin-bottom: 2.5rem;
  }
  .pq-algo-steps {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    margin-bottom: 2rem;
  }
  .pq-algo-step {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
  }
  .pq-algo-step-num {
    flex: 0 0 auto;
    width: 2.25rem;
    height: 2.25rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: color-mix(in oklab, var(--pq-gold) 15%, transparent);
    border: 1px solid color-mix(in oklab, var(--pq-gold) 40%, transparent);
    color: var(--pq-gold);
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-weight: 700;
    font-size: 0.92rem;
  }
  .pq-algo-step-body {
    min-width: 0;
  }
  .pq-algo-step-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.4rem;
  }
  .pq-algo-step-desc {
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--text-tertiary);
  }
  .pq-algo-formula {
    display: inline-block;
    margin-top: 0.75rem;
    padding: 0.5rem 0.9rem;
    border-radius: 0.5rem;
    background: color-mix(in oklab, var(--pq-gold) 10%, transparent);
    border: 1px solid color-mix(in oklab, var(--pq-gold) 30%, transparent);
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 0.88rem;
    color: var(--pq-gold);
  }
  .pq-algo-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }
  @media (min-width: 1000px) {
    .pq-algo-layout {
      grid-template-columns: 1fr 20rem;
      align-items: start;
      gap: 3rem;
    }
    .pq-algo-visual {
      position: sticky;
      /* #main-header goes `position: fixed` when the user scrolls back up
         (see Header.astro) — clearing its real measured height (set as
         --pq-header-clear by initParkQuestSuggestionGraph), not a guessed
         constant, is what keeps the fixed header from landing on top of
         this once it's pinned. */
      top: calc(var(--pq-header-clear, 5rem) + 1rem);
    }
  }

  /* Friend-suggestion visual: graph + table, the same data shown two
     ways (a graph-theory-text pairing). Auto-cycles through seven stages
     (all-lit, status, exclude, fof, parks, score, rank) off one
     data-stage attribute — every visual change is CSS (row reordering at
     "rank" is the one exception, see initParkQuestSuggestionGraph). Only
     starts once the whole graphic has scrolled fully into view (see the
     IntersectionObserver in initParkQuestSuggestionGraph). */
  .pq-algo-visual {
    max-width: 26rem;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .pq-sugg-graph {
    display: block;
    width: 100%;
    height: auto;
  }
  /* Same node vocabulary as the architecture and reconciliation diagrams
     above: gold-tinted = ours / in play, plain bg-1 with a mute stroke =
     context. Everyone starts as context; candidates turn gold the moment
     "status" separates them from friends, and friends fade from
     "strikeout" on. */
  .pq-sugg-dot {
    fill: var(--pq-bg-1);
    stroke: var(--pq-mute);
    stroke-opacity: 0.45;
    stroke-width: 1.8;
    transition: fill 0.45s ease, stroke 0.45s ease, stroke-opacity 0.45s ease, stroke-width 0.45s ease, opacity 0.45s ease;
  }
  .pq-algo-visual:not([data-stage="all"]) .pq-sugg-node:not([data-friend]) .pq-sugg-dot {
    fill: color-mix(in oklab, var(--pq-gold) 18%, var(--pq-bg-1));
    stroke: var(--pq-gold);
    stroke-opacity: 0.95;
    stroke-width: 2;
  }
  .pq-sugg-initials {
    font-size: 12px;
    font-weight: 700;
    fill: var(--pq-cream);
    pointer-events: none;
    transition: opacity 0.45s ease;
  }
  /* Spokes: solid gold to actual friends, dashed to people merely under
     evaluation — the dash is the "not a friendship (yet)" marker. */
  .pq-sugg-edge {
    stroke: var(--pq-mute);
    stroke-opacity: 0.4;
    stroke-width: 1.4;
    stroke-dasharray: 3 4;
    stroke-linecap: round;
    transition: stroke 0.45s ease, stroke-opacity 0.45s ease, opacity 0.45s ease;
  }
  .pq-sugg-edge[data-friend="true"] {
    stroke: var(--pq-gold);
    stroke-opacity: 0.75;
    stroke-dasharray: none;
  }
  .pq-algo-visual:not([data-stage="all"]) .pq-sugg-edge:not([data-friend]) {
    stroke: var(--pq-gold);
    stroke-opacity: 0.5;
  }
  .pq-sugg-fof-edge {
    stroke: var(--pq-mute);
    stroke-opacity: 0.3;
    stroke-width: 1.4;
    stroke-linecap: round;
    transition: stroke 0.45s ease, stroke-opacity 0.45s ease, stroke-width 0.45s ease;
  }
  /* Stage 3 ("strikeout"/"exclude"): already-friends drop out — dimmed,
     not deleted, so it still reads as "excluded" rather than "never
     existed." Gated to skip "status" too, so status labels land as their
     own beat before anyone gets dimmed/struck out. */
  .pq-algo-visual:not([data-stage="all"]):not([data-stage="status"]) [data-friend="true"].pq-sugg-node .pq-sugg-dot,
  .pq-algo-visual:not([data-stage="all"]):not([data-stage="status"]) [data-friend="true"].pq-sugg-node .pq-sugg-initials {
    opacity: 0.3;
  }
  .pq-algo-visual:not([data-stage="all"]):not([data-stage="status"]) line[data-friend="true"] {
    opacity: 0.15;
  }
  /* Stage 4 ("fof"): the friends-of-friends chords light up once that
     signal is the one being called out, staying lit through later stages. */
  .pq-algo-visual[data-stage="fof"] .pq-sugg-fof-edge,
  .pq-algo-visual[data-stage="parks"] .pq-sugg-fof-edge,
  .pq-algo-visual[data-stage="score"] .pq-sugg-fof-edge,
  .pq-algo-visual[data-stage="rank"] .pq-sugg-fof-edge {
    stroke: var(--pq-gold);
    stroke-opacity: 0.85;
    stroke-width: 2;
  }
  .pq-sugg-score {
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 13px;
    font-weight: 700;
    fill: var(--pq-gold);
    text-anchor: middle;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.45s ease;
    /* Halo behind the digit in the section's own background colour,
       painted before the fill (paint-order) — a spoke or chord can pass
       right behind a score label, and this keeps the number legible over
       it instead of depending on node position avoiding every line. */
    paint-order: stroke;
    stroke: color-mix(in oklab, var(--bg-card) 55%, var(--bg-primary));
    stroke-width: 4px;
    stroke-linejoin: round;
  }
  .pq-algo-visual[data-stage="score"] .pq-sugg-score,
  .pq-algo-visual[data-stage="rank"] .pq-sugg-score {
    opacity: 1;
  }
  /* Stage 7 ("rank"): the top-scoring candidate fills in solid gold,
     echoing the row that floats to the top of the table. */
  .pq-algo-visual[data-stage="rank"] [data-top="true"] .pq-sugg-dot {
    fill: color-mix(in oklab, var(--pq-gold) 45%, var(--pq-bg-1));
    stroke-width: 3;
  }
  .pq-sugg-you circle {
    fill: var(--pq-gold);
    stroke: var(--pq-gold-soft);
    stroke-width: 1;
  }
  .pq-sugg-you text {
    font-size: 12px;
    font-weight: 700;
    fill: var(--pq-bg-0);
    text-anchor: middle;
    pointer-events: none;
  }

  /* The table: same people as the graph, in the visual + attribute-table
     pairing a graph-theory text uses. Status reveals (friends struck
     through) at "exclude"; FoF (friends-of-friends) and Parks (shared
     parks) reveal one column at a time at "fof"/"parks", then the
     formula's Score at "score" — the same two signals and the same
     weighting the real algorithm uses, not a stand-in number. At "rank"
     the rows reorder in place (JS, see initParkQuestSuggestionGraph) —
     this table doubles as the final ranked list, no separate one below it. */
  .pq-sugg-table {
    width: 100%;
    /* separate, not collapse: with collapsed borders the line between two
       rows is shared/owned by whichever cell wins the collapse, so when a
       row slides during the FLIP reorder its divider doesn't travel with
       it — the text moves but the line stays put. Separate borders belong
       to each row's own cells, so the whole row (text + its line) moves
       together as one block. */
    border-collapse: separate;
    border-spacing: 0;
    font-size: 0.78rem;
    transition: opacity 0.45s ease;
  }
  .pq-sugg-table th {
    text-align: left;
    padding: 0.4rem 0.4rem;
    font-size: 0.65rem;
    font-weight: 600;
    color: var(--text-tertiary);
    border-bottom: 1px solid var(--border-primary);
    transition: color 0.45s ease;
  }
  /* Score column header lights up gold once its number is calculated,
     staying lit through the resort at "rank" that it caused. */
  .pq-algo-visual[data-stage="score"] .pq-sugg-th-score,
  .pq-algo-visual[data-stage="rank"] .pq-sugg-th-score {
    color: var(--pq-gold);
  }
  .pq-sugg-table th:nth-child(n+3),
  .pq-sugg-table td:nth-child(n+3) {
    text-align: right;
  }
  .pq-sugg-table td {
    padding: 0.4rem 0.4rem;
    border-bottom: 1px solid var(--border-secondary);
    color: var(--text-primary);
    transition: opacity 0.45s ease;
  }
  .pq-sugg-table tbody tr {
    transition: opacity 0.45s ease;
  }
  .pq-algo-visual:not([data-stage="all"]):not([data-stage="status"]) .pq-sugg-table tr[data-friend="true"] {
    opacity: 0.4;
  }
  .pq-algo-visual:not([data-stage="all"]):not([data-stage="status"]) .pq-sugg-table tr[data-friend="true"] .pq-sugg-row-name,
  .pq-algo-visual:not([data-stage="all"]):not([data-stage="status"]) .pq-sugg-table tr[data-friend="true"] .pq-sugg-row-status {
    text-decoration: line-through;
    text-decoration-color: var(--text-tertiary);
  }
  .pq-algo-visual[data-stage="rank"] .pq-sugg-table tr[data-top="true"] td {
    color: var(--pq-gold);
  }
  /* Anchors the rank number so it can sit outside the table's left edge
     (see .pq-sugg-row-rank) instead of taking up space in the cell —
     avatars/names stay flush left with the "Person" header either way. */
  .pq-sugg-row-person {
    position: relative;
  }
  /* Positioned outside the table to the left of its own row (not inline
     in the cell, so it doesn't push the name out of alignment with the
     "Person" header). Lives inside the row's own <td> rather than a
     separate element so it automatically travels with the row's FLIP
     transform during the resort, no extra JS syncing needed. */
  .pq-sugg-row-rank {
    position: absolute;
    left: -1.35rem;
    top: 50%;
    transform: translateY(-50%);
    width: 1.1rem;
    text-align: right;
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--pq-gold);
    opacity: 0;
    transition: opacity 0.45s ease;
  }
  /* Gated on .is-ranked (set via JS after the FLIP resort settles), not
     [data-stage="rank"] directly — the numbers should land once sorting
     has visibly finished, not the instant the rows start sliding. */
  .pq-algo-visual.is-ranked .pq-sugg-row-rank {
    opacity: 1;
  }
  .pq-sugg-row-avatar {
    display: inline-grid;
