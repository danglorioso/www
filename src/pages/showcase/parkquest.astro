// Simplified friend-suggestion visual: "you" at the center, linked
// directly to everyone else. Already-friends fade out first, the
// remaining candidates get scored, and the top scorers become the final
// suggestions list — paired with a table beneath the graph (the same
// data in tabular form), the way a graph-theory text usually shows a
// graph next to its adjacency/attribute table rather than picking one.
const SUGG_SIZE = 420;
const SUGG_CENTER = SUGG_SIZE / 2;
const SUGG_YOU_R = 26;
const SUGG_NODE_R = 17;
const SUGG_RADIUS = 165;

function suggTrim(x1: number, y1: number, x2: number, y2: number, r1: number, r2: number) {
  const dx = x2 - x1;
  const dy = y2 - y1;
  const dist = Math.hypot(dx, dy) || 1;
  const ux = dx / dist;
  const uy = dy / dist;
  return {
    x1: Math.round((x1 + ux * r1) * 10) / 10,
    y1: Math.round((y1 + uy * r1) * 10) / 10,
    x2: Math.round((x2 - ux * r2) * 10) / 10,
    y2: Math.round((y2 - uy * r2) * 10) / 10,
  };
}

// Same first names as the "Friends & feed" bento card earlier on the page,
// so this reads as the same people. Candidates carry the real two signals
// the algorithm scores — mutual (friends-of-friends) and shared (co-visited
// parks) — with score computed from the same formula shown below
// (score = mutual × 3 + shared × 2), not a stand-in number.
// First names only, each starting with a different letter — one-letter
// initials (M/J/A/T/S/R/C/D) stay unambiguous without a last name.
//
// Listed in ring order, arranged so every friends-of-friends pair (see
// suggFoFPairs) sits on adjacent spokes — their connecting chord is then
// short and hugs the rim instead of cutting across the hub.
const suggPeopleRaw: { id: string; name: string; initials: string; isFriend: boolean; mutual?: number; shared?: number }[] = [
  { id: "p7", name: "Casey", initials: "C", isFriend: false, mutual: 1, shared: 0 },
  { id: "p1", name: "Maya", initials: "M", isFriend: true },
  { id: "p4", name: "Taylor", initials: "T", isFriend: false, mutual: 2, shared: 1 },
  { id: "p2", name: "Jordan", initials: "J", isFriend: true },
  { id: "p5", name: "Sam", initials: "S", isFriend: false, mutual: 0, shared: 3 },
  { id: "p8", name: "Drew", initials: "D", isFriend: false, mutual: 0, shared: 1 },
  { id: "p6", name: "Riley", initials: "R", isFriend: false, mutual: 1, shared: 1 },
  { id: "p3", name: "Alex", initials: "A", isFriend: true },
];
const suggPeopleBase = suggPeopleRaw.map((p) => ({ ...p, score: (p.mutual ?? 0) * 3 + (p.shared ?? 0) * 2 }));

// Which specific friend each candidate's "mutual" count actually comes
// from — the friends-of-friends pairs Signal A is named after, drawn as
// chords between neighbouring spokes. Counts per pair sum to each
// candidate's own `mutual` value above (Taylor: 2 → Maya + Jordan;
// Riley: 1 → Alex; Casey: 1 → Maya).
const suggFoFPairs: [string, string][] = [
  ["p4", "p1"],
  ["p4", "p2"],
  ["p6", "p3"],
  ["p7", "p1"],
];

const suggPeople = suggPeopleBase.map((p, i) => {
  const angle = (i / suggPeopleBase.length) * Math.PI * 2 - Math.PI / 2;
  return {
    ...p,
    x: Math.round((SUGG_CENTER + SUGG_RADIUS * Math.cos(angle)) * 10) / 10,
    y: Math.round((SUGG_CENTER + SUGG_RADIUS * Math.sin(angle)) * 10) / 10,
  };
});

const suggEdges = suggPeople.map((p) =>
  suggTrim(SUGG_CENTER, SUGG_CENTER, p.x, p.y, SUGG_YOU_R, SUGG_NODE_R)
);

const suggPeopleById = new Map(suggPeople.map((p) => [p.id, p]));
const suggFoFEdges = suggFoFPairs.map(([aId, bId]) => {
  const a = suggPeopleById.get(aId)!;
  const b = suggPeopleById.get(bId)!;
  return suggTrim(a.x, a.y, b.x, b.y, SUGG_NODE_R, SUGG_NODE_R);
});

const suggCandidatesRanked = suggPeople
  .filter((p) => !p.isFriend)
  .sort((a, b) => b.score - a.score);
const suggTopCandidateId = suggCandidatesRanked[0]?.id;
const suggRankById = new Map(suggCandidatesRanked.map((p, i) => [p.id, i + 1]));

