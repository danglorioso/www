  .pq-algo-visual:not([data-stage="all"]) tr:not([data-friend]) .pq-sugg-row-avatar {
    background: color-mix(in oklab, var(--pq-gold) 18%, var(--pq-bg-1));
    box-shadow: inset 0 0 0 1px var(--pq-gold);
